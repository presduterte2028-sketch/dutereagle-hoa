<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mar's Touch — Luxury Home Massage Service</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        :root {
            --fire-orange: #ff4500;
            --fire-gold: #ffaa00;
            --fire-red: #d00000;
            --bg-dark: #070302;
            --card-bg: rgba(22, 11, 9, 0.85);
            --border-color: #2e120b;
        }

        body {
            background-color: var(--bg-dark);
            color: #ffffff;
            line-height: 1.6;
        }

        /* Navigation Header */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 20px;
            background-color: rgba(7, 3, 2, 0.95);
            backdrop-filter: blur(10px);
            position: sticky;
            top: 0;
            z-index: 100;
            border-bottom: 1px solid var(--border-color);
        }

        .logo {
            font-size: 1.1rem;
            font-weight: 900;
            letter-spacing: 2px;
            background: linear-gradient(135deg, var(--fire-gold), var(--fire-orange));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .logo span {
            color: #b38b82;
            font-size: 0.65rem;
            display: block;
            letter-spacing: 1.5px;
            font-weight: 400;
            -webkit-text-fill-color: initial;
        }

        .btn-header {
            background: linear-gradient(135deg, var(--fire-orange), var(--fire-red));
            color: #ffffff;
            padding: 10px 18px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 700;
            font-size: 0.85rem;
            box-shadow: 0 0 15px rgba(255, 69, 0, 0.4);
            border: none;
            cursor: pointer;
        }

        /* Hero Section */
        .hero {
            padding: 40px 20px 30px;
            text-align: left;
        }

        .hero-tag {
            color: var(--fire-orange);
            font-size: 0.75rem;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .hero h1 {
            font-family: Georgia, serif;
            font-size: 2.8rem;
            line-height: 1.1;
            margin-bottom: 16px;
            font-weight: normal;
        }

        .hero p {
            color: #b38b82;
            font-size: 0.95rem;
            margin-bottom: 15px;
        }

        .location-note {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #e09f91;
            font-size: 0.82rem;
            margin-bottom: 24px;
        }

        .hero-btns {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--fire-orange), var(--fire-red));
            color: #ffffff;
            padding: 14px 20px;
            border-radius: 10px;
            text-decoration: none;
            font-weight: 700;
            font-size: 1rem;
            text-align: center;
            box-shadow: 0 0 20px rgba(255, 69, 0, 0.35);
            border: none;
            cursor: pointer;
        }

        .btn-secondary {
            background-color: #1a0a07;
            border: 1px solid var(--border-color);
            color: #ffffff;
            padding: 14px 20px;
            border-radius: 10px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.95rem;
            text-align: center;
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            padding: 30px 20px;
            border-top: 1px solid var(--border-color);
            border-bottom: 1px solid var(--border-color);
            background: rgba(15, 6, 4, 0.6);
        }

        .stat-card h3 {
            font-size: 1.8rem;
            color: var(--fire-orange);
            font-weight: 800;
        }

        .stat-card p {
            color: #b38b82;
            font-size: 0.78rem;
        }

        /* Section Styling */
        .section-title {
            padding: 40px 20px 10px;
            text-align: center;
        }

        .section-title .subtitle {
            color: var(--fire-orange);
            font-size: 0.75rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            font-weight: 700;
        }

        .section-title h2 {
            font-family: Georgia, serif;
            font-size: 2rem;
            margin-top: 4px;
            font-weight: normal;
        }

        .section-title p {
            color: #b38b82;
            font-size: 0.88rem;
            margin-top: 6px;
        }

        /* Service Cards */
        .cards-container {
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 20px;
            position: relative;
        }

        .price-badge {
            position: absolute;
            top: 20px;
            right: 20px;
            color: var(--fire-orange);
            font-size: 0.75rem;
            font-weight: 800;
            letter-spacing: 1px;
        }

        .card-header {
            display: flex;
            gap: 14px;
            margin-bottom: 12px;
        }

        .card-thumb {
            width: 60px;
            height: 60px;
            border-radius: 12px;
            object-fit: cover;
            background-color: #240e0a;
        }

        .card-title {
            font-size: 1.2rem;
            font-weight: 700;
        }

        .card-tagline {
            color: var(--fire-gold);
            font-size: 0.8rem;
            font-style: italic;
        }

        .card-desc {
            color: #c4a198;
            font-size: 0.85rem;
            margin-bottom: 16px;
        }

        .duration-options {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 16px;
        }

        .duration-btn {
            background-color: #140705;
            border: 1px solid var(--border-color);
            color: #e0d0cc;
            padding: 10px 14px;
            border-radius: 20px;
            font-size: 0.82rem;
            text-align: left;
            cursor: pointer;
        }

        .duration-btn.active {
            border-color: var(--fire-gold);
            background-color: #2e110a;
            color: #ffffff;
        }

        /* How It Works Steps */
        .steps-container {
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .step-item {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .step-num {
            font-size: 2.2rem;
            font-weight: 900;
            color: rgba(255, 69, 0, 0.35);
        }

        .step-item h4 {
            font-size: 1.1rem;
            color: #ffffff;
        }

        .step-item p {
            color: #b38b82;
            font-size: 0.85rem;
        }

        /* Reviews */
        .reviews-container {
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .review-card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 18px;
        }

        .stars {
            color: var(--fire-orange);
            margin-bottom: 8px;
            font-size: 0.9rem;
        }

        .review-text {
            font-style: italic;
            color: #e0d0cc;
            font-size: 0.88rem;
            margin-bottom: 10px;
        }

        .review-author {
            color: #b38b82;
            font-size: 0.8rem;
            font-weight: 600;
        }

        /* Modal Popup */
        .booking-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.9);
            backdrop-filter: blur(6px);
            z-index: 200;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .booking-modal.active {
            display: flex;
        }

        .modal-content {
            background-color: #120503;
            border: 1px solid var(--fire-orange);
            border-radius: 16px;
            padding: 24px;
            width: 100%;
            max-width: 440px;
            max-height: 90vh;
            overflow-y: auto;
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 18px;
        }

        .modal-header h2 {
            color: var(--fire-gold);
            font-size: 1.3rem;
        }

        .close-btn {
            background: none;
            border: none;
            color: #b38b82;
            font-size: 1.6rem;
            cursor: pointer;
        }

        .form-group {
            margin-bottom: 14px;
        }

        .form-group label {
            display: block;
            font-size: 0.8rem;
            color: #b38b82;
            margin-bottom: 6px;
        }

        .form-group input, .form-group select {
            width: 100%;
            padding: 10px 12px;
            background-color: #1a0a07;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            color: #ffffff;
            font-size: 0.9rem;
        }

        .qr-section {
            display: none;
            background: rgba(30, 10, 5, 0.9);
            border: 1px dashed var(--fire-gold);
            border-radius: 12px;
            padding: 16px;
            text-align: center;
            margin-bottom: 16px;
        }

        .qr-section.active {
            display: block;
        }

        .qr-image-container {
            background-color: #ffffff;
            padding: 10px;
            border-radius: 10px;
            display: inline-block;
            margin: 10px 0;
        }

        .qr-image-container img {
            max-width: 200px;
            width: 100%;
            display: block;
        }

        /* Footer */
        footer {
            padding: 40px 20px 20px;
            border-top: 1px solid var(--border-color);
            background-color: #040101;
            margin-top: 40px;
        }

        .footer-brand {
            font-size: 1.2rem;
            font-weight: 800;
            color: var(--fire-orange);
            margin-bottom: 8px;
        }

        .footer-contact {
            color: #b38b82;
            font-size: 0.85rem;
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-top: 16px;
        }

        .copyright {
            margin-top: 30px;
            text-align: center;
            color: #52312b;
            font-size: 0.75rem;
        }
    </style>
</head>
<body>

    <!-- Header Navigation -->
    <header>
        <div class="logo">
            MAR'S TOUCH
            <span>HOME MASSAGE</span>
        </div>
        <button class="btn-header" onclick="openBookingForm()">Book Now</button>
    </header>

    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-tag"><span>✨</span> Luxury Home Massage Service</div>
        <h1>Mar's Touch Comes to You</h1>
        <p>Professional massage therapy delivered to your home, hotel, or office. Available daily 9 AM – 9 PM.</p>
        <div class="location-note">📍 We bring everything — table, oils, equipment</div>
        <div class="hero-btns">
            <button class="btn-primary" onclick="openBookingForm()">Book a Session ›</button>
            <a href="#services" class="btn-secondary">See Services & Pricing</a>
        </div>
    </section>

    <!-- Stats Section -->
    <section class="stats-grid">
        <div class="stat-card">
            <h3>9AM–9PM</h3>
            <p>Daily Availability</p>
        </div>
        <div class="stat-card">
            <h3>8,000+</h3>
            <p>Happy Clients</p>
        </div>
        <div class="stat-card">
            <h3>4</h3>
            <p>Massage Types</p>
        </div>
        <div class="stat-card">
            <h3>100%</h3>
            <p>Certified Therapists</p>
        </div>
    </section>

    <!-- Services Section -->
    <section id="services">
        <div class="section-title">
            <div class="subtitle">TREATMENTS</div>
            <h2>Our Massage Services</h2>
            <p>Choose your treatment and duration — our therapist comes to you.</p>
        </div>

        <div class="cards-container">
            <!-- Swedish Card -->
            <div class="card">
                <div class="price-badge">FROM ₱999</div>
                <div class="card-header">
                    <img src="https://images.unsplash.com/photo-1544161515-4ab6ce6db874?w=120&q=80" class="card-thumb" alt="Swedish">
                    <div>
                        <div class="card-title">Swedish Massage</div>
                        <div class="card-tagline">Gentle flows, deep peace</div>
                    </div>
                </div>
                <p class="card-desc">Classic Swedish massage with long, flowing strokes to ease muscle tension and improve circulation.</p>
                <div class="duration-options">
                    <div class="duration-btn active">1 hr — ₱999</div>
                    <div class="duration-btn">1 hr 30 min — ₱1,299</div>
                    <div class="duration-btn">2 hr — ₱1,599</div>
                </div>
                <button class="btn-primary" style="width:100%;" onclick="openBookingForm()">Book This Treatment</button>
            </div>

            <!-- Deep Tissue Card -->
            <div class="card">
                <div class="price-badge">FROM ₱1,199</div>
                <div class="card-header">
                    <img src="https://images.unsplash.com/photo-1519823551278-64ac92734fb1?w=120&q=80" class="card-thumb" alt="Deep Tissue">
                    <div>
                        <div class="card-title">Deep Tissue Massage</div>
                        <div class="card-tagline">Pressure from Mar's Touch</div>
                    </div>
                </div>
                <p class="card-desc">Firm, targeted pressure that reaches deep muscle layers to release chronic knots and tightness.</p>
                <div class="duration-options">
                    <div class="duration-btn active">1 hr — ₱1,199</div>
                    <div class="duration-btn">1 hr 30 min — ₱1,499</div>
                    <div class="duration-btn">2 hr — ₱1,799</div>
                </div>
                <button class="btn-primary" style="width:100%;" onclick="openBookingForm()">Book This Treatment</button>
            </div>

            <!-- Ventosa Card -->
            <div class="card">
                <div class="price-badge">FROM ₱1,099</div>
                <div class="card-header">
                    <img src="https://images.unsplash.com/photo-1519823551278-64ac92734fb1?w=120&q=80" class="card-thumb" alt="Ventosa">
                    <div>
                        <div class="card-title">Ventosa (Cupping)</div>
                        <div class="card-tagline">Ancient suction, modern relief</div>
                    </div>
                </div>
                <p class="card-desc">Traditional cupping therapy using heated glass cups to create suction on the skin and draw out tension.</p>
                <div class="duration-options">
                    <div class="duration-btn active">1 hr — ₱1,099</div>
                    <div class="duration-btn">1 hr 30 min — ₱1,399</div>
                </div>
                <button class="btn-primary" style="width:100%;" onclick="openBookingForm()">Book This Treatment</button>
            </div>

            <!-- Combination Card -->
            <div class="card">
                <div class="price-badge">FROM ₱1,299</div>
                <div class="card-header">
                    <img src="https://images.unsplash.com/photo-1544161515-4ab6ce6db874?w=120&q=80" class="card-thumb" alt="Combination">
                    <div>
                        <div class="card-title">Combination Massage</div>
                        <div class="card-tagline">Tailored to your body</div>
                    </div>
                </div>
                <p class="card-desc">The best of all worlds — a custom blend of Swedish, deep tissue, and targeted relief techniques.</p>
                <div class="duration-options">
                    <div class="duration-btn active">1 hr — ₱1,299</div>
                    <div class="duration-btn">1 hr 30 min — ₱1,599</div>
                    <div class="duration-btn">2 hr — ₱1,899</div>
                </div>
                <button class="btn-primary" style="width:100%;" onclick="openBookingForm()">Book This Treatment</button>
            </div>
        </div>
    </section>

    <!-- How It Works Section -->
    <section>
        <div class="section-title">
            <div class="subtitle">SIMPLE PROCESS</div>
            <h2>How It Works</h2>
        </div>
        <div class="steps-container">
            <div class="step-item">
                <div class="step-num">01</div>
                <h4>Book Online</h4>
                <p>Choose your massage type, duration, date & time.</p>
            </div>
            <div class="step-item">
                <div class="step-num">02</div>
                <h4>Confirm Address</h4>
                <p>Tell us where — home, hotel, office, wherever you are.</p>
            </div>
            <div class="step-item">
                <div class="step-num">03</div>
                <h4>We Arrive</h4>
                <p>Your licensed therapist arrives on time with all equipment.</p>
            </div>
            <div class="step-item">
                <div class="step-num">04</div>
                <h4>Pure Bliss</h4>
                <p>Relax and recover without ever leaving your space.</p>
            </div>
        </div>
    </section>

    <!-- Client Reviews Section -->
    <section>
        <div class="section-title">
            <div class="subtitle">CLIENT STORIES</div>
            <h2>What Our Guests Say</h2>
        </div>
        <div class="reviews-container">
            <div class="review-card">
                <div class="stars">★★★★★</div>
                <div class="review-text">"They came right to my door. I didn't have to drive anywhere — just answered in my robe and was in bliss within minutes."</div>
                <div class="review-author">Alicia Ramos</div>
            </div>
            <div class="review-card">
                <div class="stars">★★★★★</div>
                <div class="review-text">"Booked a deep tissue session for my wife and me at home. The therapist arrived on time, fully equipped. Incredible experience."</div>
                <div class="review-author">James Teo</div>
            </div>
            <div class="review-card">
                <div class="stars">★★★★★</div>
                <div class="review-text">"The ventosa cupping was amazing. My back felt brand new. Love that I can just relax at home after!"</div>
                <div class="review-author">Priya Singh</div>
            </div>
        </div>
    </section>

    <!-- Booking Modal -->
    <div class="booking-modal" id="bookingModal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Book Session</h2>
                <button class="close-btn" onclick="closeBookingForm()">×</button>
            </div>
            <form onsubmit="handleSubmit(event)">
                <div class="form-group">
                    <label>Full Name</label>
                    <input type="text" placeholder="e.g. Juan Dela Cruz" required>
                </div>
                <div class="form-group">
                    <label>Phone Number</label>
                    <input type="tel" placeholder="09565814679" required>
                </div>
                <div class="form-group">
                    <label>Preferred Date & Time</label>
                    <input type="datetime-local" required>
                </div>
                <div class="form-group">
                    <label>Payment Method</label>
                    <select id="paymentMethod" onchange="toggleQR()" required>
                        <option value="Cash">Cash after Session</option>
                        <option value="GCash">GCash / InstaPay (50% Downpayment)</option>
                    </select>
                </div>

                <div class="qr-section" id="qrContainer">
                    <p style="font-size:0.85rem; font-weight:bold; color:#fff;">Scan QR Code to Pay 50% Downpayment</p>
                    <div class="qr-image-container">
                        <img src="1000015310_2.jpg" alt="InstaPay QR Code">
                    </div>
                    <p style="color:var(--fire-gold); font-size:0.85rem; font-weight:bold;">Account: ED**R G.</p>
                    <p style="color:#b38b82; font-size:0.78rem; margin-top:4px;">⚠️ Pay 50% downpayment to lock in your slot. Remaining balance after massage.</p>
                </div>

                <div class="form-group" id="uploadContainer" style="display:none;">
                    <label>Upload Proof of Payment (Screenshot)</label>
                    <input type="file" accept="image/*">
                </div>

                <button type="submit" class="btn-primary" style="width:100%; margin-top:10px;">Confirm & Book Session</button>
            </form>
        </div>
    </div>

    <!-- Footer -->
    <footer>
        <div class="footer-brand">MAR'S TOUCH</div>
        <p style="color:#b38b82; font-size:0.85rem;">Premium home massage service. We come to you — daily from 9 AM to 9 PM.</p>
        
        <div class="footer-contact">
            <div>🕒 Daily: 9:00 AM – 9:00 PM</div>
            <div>📞 +63 956 581 4679</div>
            <div>💬 WhatsApp: 09565814679</div>
            <div>📍 Home, Hotel, or Office — We Come To You</div>
        </div>

        <div class="copyright">
            © 2026 Mar's Touch Home Massage. All rights reserved.
        </div>
    </footer>

    <script>
        function openBookingForm() {
            document.getElementById('bookingModal').classList.add('active');
        }

        function closeBookingForm() {
            document.getElementById('bookingModal').classList.remove('active');
        }

        function toggleQR() {
            const method = document.getElementById('paymentMethod').value;
            const qrContainer = document.getElementById('qrContainer');
            const uploadContainer = document.getElementById('uploadContainer');
            if (method === 'GCash') {
                qrContainer.classList.add('active');
                uploadContainer.style.display = 'block';
            } else {
                qrContainer.classList.remove('active');
                uploadContainer.style.display = 'none';
            }
        }

        function handleSubmit(e) {
            e.preventDefault();
            alert('Booking submitted! We will verify your schedule and payment.');
            closeBookingForm();
        }
    </script>
</body>
</html>
  
